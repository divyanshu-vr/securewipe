{
  "schemaVersion": "1.0.0",
  "categories": {
    "safe": {
      "extensions": [".tmp", ".cache", ".log", ".bak", ".old", ".~", ".swp", ".dmp"],
      "pathPatterns": ["temp", "cache", "logs", "downloads", "recycle", "trash", "temporary internet files"],
      "description": "Files safe to delete without data loss"
    },
    "lessImportant": {
      "extensions": [".doc", ".docx", ".pdf", ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".mp4", ".avi", ".mp3", ".wav", ".txt", ".rtf"],
      "pathPatterns": ["documents", "pictures", "videos", "music", "desktop", "my documents"],
      "description": "User files that may have value but are not critical"
    },
    "important": {
      "extensions": [".exe", ".dll", ".sys", ".ini", ".cfg", ".config", ".msi", ".bat", ".cmd", ".ps1"],
      "pathPatterns": ["windows", "program files", "system32", "usr", "etc", "bin", "sbin", "boot"],
      "description": "System files and applications - deletion may cause issues"
    }
  },
  "accessTimeRules": {
    "oldFileThresholdDays": 365,
    "recentFileThresholdDays": 30
  }
}