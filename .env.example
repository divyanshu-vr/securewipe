# SecureWipe Configuration Template

# Cryptography Settings
SECUREWIPE_CRYPTO_BACKEND=pyca  # pyca or minisign
SECUREWIPE_KEY_DIR=~/.securewipe/keys

# Logging Configuration
SECUREWIPE_LOG_LEVEL=INFO
SECUREWIPE_LOG_FILE=~/.securewipe/logs/securewipe.log

# Development Settings
SECUREWIPE_DEBUG=false
SECUREWIPE_TEST_MODE=false